# ============================================================================
# LEIKAH PLANT HIRE — ENVIRONMENT
#
# Copy to .env.local and fill in. The site renders completely with none of
# these set: it falls back to the content in src/content/seed, and the portal
# shows setup instructions instead of a login form that cannot work.
# ============================================================================

# --- Canonical origin -------------------------------------------------------
# Used for canonical URLs, the sitemap, and absolute social-card image URLs.
NEXT_PUBLIC_SITE_URL=https://leikahgroup.co.za

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API. The anon key is public by design and is restricted
# by row-level security; it can only read published content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, so it is used solely by the
# enquiry server actions to write submissions.
# NEVER prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Analytics 4 (not yet installed) ---------------------------------
# Placeholder only. Nothing in the codebase reads this yet, and no tracking
# script ships until it does. Leaving it blank is the current, deliberate
# state: see google-search-console/analytics-setup.md for where the tag goes
# and what has to happen to the cookie banner before it is switched on.
#
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Search Console --------------------------------------------------
# Only needed if verifying by HTML meta tag instead of DNS. DNS is preferred;
# see google-search-console/verification.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
